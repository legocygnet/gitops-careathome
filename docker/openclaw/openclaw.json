{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "${OPENCLAW_UI_ORIGIN}",
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://ollama:11434",
        "api": "ollama",
        "apiKey": "ollama-local",
        "models": [
          {
            "id": "qwen3:4b-instruct",
            "name": "Qwen 3 4B Instruct",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 262144,
            "contextTokens": 16384,
            "maxTokens": 2048
          },
          {
            "id": "qwen3:4b-thinking",
            "name": "Qwen 3 4B Thinking",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 262144,
            "contextTokens": 16384,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": { "primary": "ollama/qwen3:4b-instruct" },
      "contextTokens": 16384,
      "maxConcurrent": 1,
      "models": {
        "ollama/qwen3:4b-instruct": {
          "alias": "instruct",
          "params": { "num_ctx": 16384 }
        },
        "ollama/qwen3:4b-thinking": {
          "alias": "thinking",
          "params": { "num_ctx": 16384 }
        }
      }
    }
  },
  "tools": { "profile": "minimal" }
}
