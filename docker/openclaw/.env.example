# Required: supply a unique, high-entropy secret in Portainer or a private .env.
# A password manager can generate it. Never commit the actual token.
OPENCLAW_GATEWAY_TOKEN=

# LAN-only default; use HTTPS before processing sensitive information.
# For SSH-tunnel-only access, use 127.0.0.1 and http://localhost:18789.
OPENCLAW_BIND_ADDRESS=0.0.0.0
OPENCLAW_UI_ORIGIN=http://careathome:18789
